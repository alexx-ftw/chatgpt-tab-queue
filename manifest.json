{
  "manifest_version": 3,
  "name": "ChatGPT Queue · Tab",
  "version": "0.6.2",
  "description": "Tab encola texto y adjuntos. Colas independientes con contextos internos, sin abrir pestañas ni cambiar el chat visible.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir todas las colas",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "options_page": "ui/manager.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core/adapter.js",
        "core/client.js",
        "core/file-matching.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "incognito": "not_allowed",
  "version_name": "0.6.2 · Queue panel recovery",
  "update_url": "https://github.com/alexx-ftw/chatgpt-tab-queue/releases/latest/download/updates.xml",
  "homepage_url": "https://github.com/alexx-ftw/chatgpt-tab-queue",
  "key": ""
}
